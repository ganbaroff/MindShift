{
  "name": "agency",
  "version": 1,
  "format": "integronix-agency-promo",
  "aspect": "9:16",
  "description": "Integronix web-dev promo: ONE live site, the SITE itself moves (static front-facing device), business-metric proof, Bize yazin CTA (canon: memory/wip-agency-video.md 2026-07-10)",
  "constants": {
    "voice": { "engine": "elevenlabs", "voice_id": "IKne3meq5aSn9XLyUdCD", "voice_name": "Charlie", "model": "eleven_v3", "language": "az" },
    "music": { "engine": "lyria", "model": "lyria-3-clip-preview", "duck": "sidechaincompress" },
    "audio_norm": "loudnorm=I=-15:TP=-1.5:LRA=11 (timed to voice length)",
    "duration_band_sec": [17, 24],
    "palette": { "navy": "#112239", "teal": "#63B4C7", "text": "#EAF1F7", "never": "red" },
    "brand": "INTEGRONIX",
    "rules": ["site moves, not the device", "no tech jargon in proof (business metrics only)", "no dead posters", "one CTA: Bizə yazın — sorğu göndərin"]
  },
  "stations": [
    { "id": "site",     "producer": "webdemo/flagship/index.html", "watcher": "frame_check.mjs", "needs": [] },
    { "id": "record",   "producer": "prep_assets.mjs",  "watcher": "frame_check.mjs",  "needs": ["site"] },
    { "id": "voice",    "producer": "el_voice.mjs",     "watcher": "send_ear_sample.mjs", "human_gate": "ceo_ear", "needs": [] },
    { "id": "mix",      "producer": "mix_music.mjs",    "watcher": "gates.mjs",        "needs": ["voice"] },
    { "id": "device",   "producer": "record_3d.mjs",    "watcher": "frame_check.mjs",  "needs": ["record"] },
    { "id": "assemble", "producer": "build_reel7.mjs",  "watcher": "gates.mjs",        "needs": ["device", "mix"] },
    { "id": "critic",   "producer": "critic_agency.mjs","watcher": "critic_agency.mjs","needs": ["assemble"] },
    { "id": "deliver",  "producer": "tg_send.mjs",      "watcher": "tg_send.mjs",      "human_gate": "ceo_ok", "needs": ["critic"] }
  ],
  "human_gates": ["ceo_ear", "ceo_ok"],
  "critic_bar": { "rule": "no evidenced <=2 AND mean >= 3.5", "escalate_band": [3.3, 3.7], "ceo_directed_exceptions": ["example_variety (one-site canon)", "motion_aliveness device-static (site moves, not device)"] }
}
